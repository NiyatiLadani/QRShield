# QRShield Backend - Environment Variables
# Copy this file to .env and fill in your values.

# Django Core
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.yourdomain.com

# CORS - comma-separated list of allowed origins
# Leave unset to allow all origins (development only)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Threat Intelligence API Keys
GOOGLE_SAFE_BROWSING_API_KEY=your-google-safe-browsing-api-key
VIRUSTOTAL_API_KEY=your-virustotal-api-key
URLHAUS_API_KEY=your-urlhaus-api-key
